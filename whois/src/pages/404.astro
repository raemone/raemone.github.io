---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NAV_PAGES } from '@/lib/pages';
import { localizePath, t } from '@/i18n';
import { DEFAULT_LANG } from '@/i18n/ui';

// GitHub Pages serves a single 404 for the whole site, so it renders in the
// default language and links back into the localised pages from there.
const lang = DEFAULT_LANG;
---

<BaseLayout lang={lang} pageId="home" title={t('404.title', lang)} description={t('404.lead', lang)}>
  <section class="container-page flex min-h-[60vh] flex-col justify-center py-20">
    <p class="label-mono">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">{t('404.title', lang)}</h1>
    <p class="mt-4 max-w-md text-base text-muted">{t('404.lead', lang)}</p>

    <nav class="mt-10 flex flex-wrap gap-2" aria-label={t('404.title', lang)}>
      {
        NAV_PAGES.map((page) => (
          <a
            href={localizePath(page.path, lang)}
            class="rounded-lg border border-border px-4 py-2 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
          >
            {t(page.labelKey, lang)}
          </a>
        ))
      }
    </nav>
  </section>
</BaseLayout>
