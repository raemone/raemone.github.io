{
  "name": "bootcamp-registration-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "start:http": "node --env-file-if-exists=.env dist/server/main.js --http",
    "test": "tsx --test tests/registration.test.ts",
    "test:ui": "npm run build && tsx --test tests/ui.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/msal-node": "^7.2.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
